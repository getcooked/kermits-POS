<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="1-sign-up-and-log-in" name="1. Sign up and log in"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Figure 1 - Sign up and log in" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-110" width="900" height="30" as="geometry"/></mxCell><mxCell id="caption" value="Registration is the only way a customer row enters the Customer Database (users table, role = customer). Every login is checked against it before the user is routed by role. Google sign-in only works for an existing customer with a verified email." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=12;fontColor=#5a665e;" vertex="1" parent="1"><mxGeometry x="20" y="-76" width="1000" height="50" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Visitor opens website or app&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="390" y="16" width="220" height="40" as="geometry"/></mxCell><mxCell id="hasAcc" value="&lt;b&gt;Has an account?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="200" height="80" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Enter Gmail address&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;must be an unused @gmail.com&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="45" y="176" width="230" height="56" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Email a 6-digit code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;expires in 10 minutes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="45" y="256" width="230" height="56" as="geometry"/></mxCell><mxCell id="code" value="&lt;b&gt;Code correct?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="200" height="80" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Fill in profile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;name · phone · birthday&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;sex · address · password&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="45" y="440" width="230" height="68" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Create customer account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;role = customer, email verified&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="45" y="532" width="230" height="56" as="geometry"/></mxCell><mxCell id="custT" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d6ddd8&quot;&gt;Shop · orders · profile&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="45" y="690" width="230" height="44" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#2b7a4b&quot;&gt;users · role = customer&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #2b7a4b&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px&quot;&gt;id&lt;br&gt;name&lt;br&gt;email&lt;br&gt;phone&lt;br&gt;birthday&lt;br&gt;sex&lt;br&gt;address&lt;br&gt;password (hashed)&lt;br&gt;google_id&lt;br&gt;email_verified_at&lt;br&gt;disabled_at&lt;br&gt;deleted_at&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e2f0e6;strokeColor=#2b7a4b;strokeWidth=2;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="410" y="250" width="180" height="340" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;Log in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;email + password + reCAPTCHA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;or Continue with Google&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="705" y="176" width="230" height="68" as="geometry"/></mxCell><mxCell id="cred" value="&lt;b&gt;Credentials valid?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="715" y="268" width="210" height="80" as="geometry"/></mxCell><mxCell id="lockNote" value="error shown; locks after repeated failures" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#5a665e;" vertex="1" parent="1"><mxGeometry x="964" y="236" width="130" height="50" as="geometry"/></mxCell><mxCell id="dis" value="&lt;b&gt;Account disabled?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="715" y="372" width="210" height="80" as="geometry"/></mxCell><mxCell id="denied" value="&lt;b&gt;Access denied&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="965" y="392" width="120" height="40" as="geometry"/></mxCell><mxCell id="role" value="&lt;b&gt;Which role?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="715" y="476" width="210" height="80" as="geometry"/></mxCell><mxCell id="cashT" value="&lt;b&gt;Cashier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d6ddd8&quot;&gt;Point of sale · table floor&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="705" y="690" width="230" height="44" as="geometry"/></mxCell><mxCell id="saT" value="&lt;b&gt;Super Admin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d6ddd8&quot;&gt;Dashboard&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="965" y="690" width="120" height="44" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="hasAcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hasAcc" target="r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="126"/></Array></mxGeometry></mxCell><mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hasAcc" target="l1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="126"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="code"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="code" target="r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="28" y="376"/><mxPoint x="28" y="284"/></Array></mxGeometry></mxCell><mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="code" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="INSERT row" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#2b7a4b;fontStyle=1;fontColor=#2b7a4b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9118;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4" target="custT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="cred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="reads email, hash, google_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#2b7a4b;fontStyle=1;fontColor=#2b7a4b;exitX=1;exitY=0.1706;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="cred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cred" target="l1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="958" y="308"/><mxPoint x="958" y="210"/></Array></mxGeometry></mxCell><mxCell id="e14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cred" target="dis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="reads disabled_at" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#2b7a4b;fontStyle=1;fontColor=#2b7a4b;exitX=1;exitY=0.4765;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="dis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dis" target="denied"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dis" target="role"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="customer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="role" target="custT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="516"/><mxPoint x="650" y="640"/><mxPoint x="160" y="640"/></Array></mxGeometry></mxCell><mxCell id="e19" value="cashier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="role" target="cashT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="super admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="role" target="saT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="516"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="2-customer-tasks" name="2. Customer tasks"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Figure 2 - What a customer does after logging in" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-110" width="900" height="30" as="geometry"/></mxCell><mxCell id="caption" value="Orders store customer_id; reservations store user_id plus a copy of the name, email and phone at booking time. The History page shows only rows that match the logged-in customer." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=12;fontColor=#5a665e;" vertex="1" parent="1"><mxGeometry x="20" y="-76" width="1000" height="50" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Customer home (Shop)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="440" y="16" width="220" height="40" as="geometry"/></mxCell><mxCell id="task" value="&lt;b&gt;Choose a task&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="450" y="74" width="200" height="72" as="geometry"/></mxCell><mxCell id="prof" value="&lt;b&gt;Edit own profile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;see page 3&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="460" y="176" width="180" height="52" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#2b7a4b&quot;&gt;users · role = customer&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #2b7a4b&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px&quot;&gt;id (primary key)&lt;br&gt;name · email · phone&lt;br&gt;birthday · sex · address&lt;br&gt;password · google_id&lt;br&gt;disabled_at · deleted_at&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e2f0e6;strokeColor=#2b7a4b;strokeWidth=2;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="460" y="256" width="180" height="214" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;Choose items&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;and payment method&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="200" height="56" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;Submit order&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;stock checked and deducted&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="200" height="56" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;Payment confirmed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;by cashier or PayMongo&lt;/span&g