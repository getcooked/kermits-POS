x="1" parent="1"><mxGeometry x="20" y="-110" width="900" height="30" as="geometry"/></mxCell><mxCell id="caption" value="Customers cannot change their own email or role here. After a password change the current session stays signed in; every other browser session and mobile app token is revoked." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=12;fontColor=#5a665e;" vertex="1" parent="1"><mxGeometry x="20" y="-76" width="1000" height="50" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Customer opens My Profile&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="390" y="16" width="220" height="40" as="geometry"/></mxCell><mxCell id="tab" value="&lt;b&gt;Which tab?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="410" y="80" width="180" height="72" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Edit personal details&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;name · phone · birthday&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;sex · address&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="45" y="176" width="210" height="68" as="geometry"/></mxCell><mxCell id="av" value="&lt;b&gt;Details valid?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="55" y="268" width="190" height="80" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Save changes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;phone must be 09XXXXXXXXX&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="210" height="56" as="geometry"/></mxCell><mxCell id="aT" value="&lt;b&gt;Profile updated&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="45" y="452" width="210" height="40" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#2b7a4b&quot;&gt;this customer's row&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #2b7a4b&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:11px&quot;&gt;name&lt;br&gt;phone&lt;br&gt;birthday&lt;br&gt;sex&lt;br&gt;address&lt;br&gt;email&lt;br&gt;password (hashed)&lt;br&gt;remember_token&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e2f0e6;strokeColor=#2b7a4b;strokeWidth=2;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="180" height="360" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Request email code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;6 digits, valid 10 minutes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="745" y="176" width="210" height="56" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Enter code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;and the new passw