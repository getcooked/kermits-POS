X=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="bc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bc" target="b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="972" y="376"/><mxPoint x="972" y="284"/></Array></mxGeometry></mxCell><mxCell id="e14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bc" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="UPDATE password" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#2b7a4b;fontStyle=1;fontColor=#2b7a4b;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8722;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#18221c;fontStyle=1;fontColor=#5a665e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="bT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="4-super-admin-customers" name="4. Super Admin customers"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Figure 4 - Super Admin: managing customer profiles" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-110" width="900" height="30" as="geometry"/></mxCell><mxCell id="caption" value="Deleting a customer keeps sales records: the account is renamed &quot;Deleted Customer #id&quot;, personal fields are cleared, reservations are anonymised and payment proofs removed, mobile sessions revoked, and the row soft-deleted." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;text;align=left;verticalAlign=top;fontSize=12;fontColor=#5a665e;" vertex="1" parent="1"><mxGeometry x="20" y="-76" width="1000" height="50" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Super Admin opens Customers&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=1;arcSize=50;fillColor=#18221c;strokeColor=#18221c;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="16" width="220" height="40" as="geometry"/></mxCell><mxCell id="list" value="&lt;b&gt;List customers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;orders, total spent, bookings&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="220" height="56" as="geometry"/></mxCell><mxCell id="ed" value="&lt;b&gt;Edit account?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="70" y="172" width="200" height="76" as="geometry"/></mxCell><mxCell id="eb" value="&lt;b&gt;Update account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;name, email, phone, birthday,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;sex, address, new password&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="360" y="172" width="240" height="76" as="geometry"/></mxCell><mxCell id="del" value="&lt;b&gt;Delete account?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="70" y="292" width="200" height="76" as="geometry"/></mxCell><mxCell id="xb" value="&lt;b&gt;Anonymise account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;clear personal fields, revoke&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;mobile sessions, soft-delete&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="360" y="292" width="240" height="76" as="geometry"/></mxCell><mxCell id="vw" value="&lt;b&gt;View history?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rhombus;fillColor=#fbf3db;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="70" y="412" width="200" height="76" as="geometry"/></mxCell><mxCell id="vb" value="&lt;b&gt;Show customer history&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5a665e&quot;&gt;orders and reservations&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#18221c;rounded=0;fillColor=#ffffff;strokeColor=#18221c;" vertex="1" parent="1"><mxGeometry x="360" y="422" width="240" height="56" as="geometry"/></mxCell><mxCell id="endT" value="&lt;b&gt